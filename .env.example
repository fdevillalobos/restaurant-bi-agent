# Control database (Postgres — provided by Railway Postgres service)
CONTROL_DB_DSN=postgresql://user:password@host:5432/railway

# LLM provider (OpenRouter by default; OpenAI remains supported)
LLM_PROVIDER=openrouter

# OpenRouter
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_HTTP_REFERER=https://your-app.example
# OPENROUTER_APP_TITLE=Restaurant BI Agent

# OpenAI fallback/alternate provider
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-...

# Web app
WEB_SESSION_SECRET=replace-with-a-long-random-string
# APP_ENV=production
# PUBLIC_BASE_URL=https://your-service.up.railway.app
# WEB_COOKIE_SECURE=true

# Query timeout in milliseconds (optional, default 30000)
STATEMENT_TIMEOUT_MS_ASK=30000

# Fudo POS database — NOT set here; added via /add_dsn command after bot starts
# DATABASE_DSN=postgresql://...
# DEFAULT_RESTAURANT=my-restaurant
